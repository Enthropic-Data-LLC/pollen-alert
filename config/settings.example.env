# PollenAlert — Environment Configuration
# Copy to .env and fill in your values

# === Google Pollen API ===
# Get a key: https://developers.google.com/maps/documentation/pollen/get-api-key
GOOGLE_POLLEN_API_KEY=your_google_pollen_api_key_here

# === Telegram Output ===
# BotFather token and your chat ID
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# === Email Output (SMTP) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
SMTP_FROM=your_email@gmail.com
SMTP_TO=recipient@example.com

# === Webhook Output ===
# POST JSON payload to this URL (n8n, Node-RED, Home Assistant, Slack, etc.)
WEBHOOK_URL=https://your-webhook-url/endpoint

# === Profile ===
# Optional: override the default profile.json path
# POLLEN_PROFILE=/path/to/your/profile.json
